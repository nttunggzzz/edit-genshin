# --- Cấu hình Bot Telegram Edit Genshin (gacard) ---
# Tạo bot trên Telegram bằng cách nhắn tin với @BotFather để lấy Token
GACARD_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# Danh sách Chat ID được phép sử dụng bot (cách nhau bởi dấu phẩy)
# Lấy Chat ID của bạn bằng cách nhắn tin cho bot @userinfobot trên Telegram
GACARD_ALLOWED_CHAT_IDS=123456789

# Danh sách Admin Chat ID (có toàn quyền dùng lệnh /moi, /bomoi, /danhsach)
# Để trống sẽ dùng danh sách mặc định trong code
GACARD_ADMIN_CHAT_IDS=123456789

# Thư mục lưu bản sao ảnh kết quả sau khi ghép xong (mặc định: output)
GACARD_OUTPUT_DIR=output

# Thư mục chứa dữ liệu tài nguyên, templates và backgrounds
GACARD_DATA_DIR=data/acc-card

# Bật lưu ảnh trung gian từng bước xử lý để debug (0 = tắt, 1 = bật)
GACARD_DEBUG=0

# User-Agent mô tả danh tính khi gọi Enka.Network (Enka yêu cầu định dạng rõ ràng)
GACARD_ENKA_USER_AGENT=edit-genshin/0.1 (contact: telegram @your_username)

# Font game (HYWenHei) hiển thị số, mã acc, dòng UID (mặc định: data/acc-card/fonts/HYWenHei-85W.ttf)
# Nếu không có file font này, hệ thống sẽ tự động dùng font Be Vietnam Pro có sẵn trong assets
GACARD_DISPLAY_FONT=

# Cookie HoYoLAB của tài khoản (dành cho chế độ cào đầy đủ nhân vật, vũ khí, thám hiểm, lịch sử roll)
# Cách lấy:
# 1. Đăng nhập vào trang https://www.hoyolab.com trên trình duyệt máy tính.
# 2. Bấm F12 -> chọn tab Application (hoặc Storage trên Firefox) -> Cookies -> https://www.hoyolab.com
# 3. Sao chép toàn bộ chuỗi cookie (bắt buộc phải có ltuid_v2 và ltoken_v2).
GACARD_HOYOLAB_COOKIE=
